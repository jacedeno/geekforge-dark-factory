#!/usr/bin/env bash
# Builder: refuse to hand off anything the verifier could not reproduce, then print the
# delivery block to post in the room.
#
#   factory-handoff --orders "<ids>" --self-check "<command>" [--gaps "<text>"]
#
# Refuses when: the increment directory has uncommitted changes, the commits since the
# increment base touch anything outside it (or an earlier increment), or the self-check fails.
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

orders="" self_check="" gaps="none"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --orders) orders="$2"; shift 2 ;;
    --self-check) self_check="$2"; shift 2 ;;
    --gaps) gaps="$2"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[[ -n "$orders" ]] || die "--orders is required"
[[ -n "$self_check" ]] || die "--self-check is required (the command you ran and trust)"
factory_load_run_env
[[ -n "${STAGE_DIR:-}" ]] || die "no current increment set"
repo="$(factory_repo)"

dirty="$(git -C "$repo" status --porcelain -- "$STAGE_DIR")"
[[ -z "$dirty" ]] || { printf '%s\n' "$dirty" >&2; die "uncommitted changes in $STAGE_DIR: commit first"; }
sha="$(git -C "$repo" rev-parse HEAD)"
if [[ -n "${STAGE_BASE:-}" ]]; then
  outside="$(git -C "$repo" log --format= --name-only --author="${GIT_AUTHOR_NAME:-builder}" "$STAGE_BASE..HEAD" \
             | sort -u | grep -v -E "^(${STAGE_DIR})(/|$)" | grep -v '^$' || true)"
  [[ -z "$outside" ]] || die "your commits since the increment base touch files outside $STAGE_DIR: $outside"
fi

log="$(mktemp)"
if ! (cd "$repo" && bash -c "$self_check") >"$log" 2>&1; then
  tail -n 40 "$log" >&2; rm -f "$log"
  die "self-check failed; fix it before handing off"
fi
summary="$(grep -v '^\s*$' "$log" | tail -n 1)"
rm -f "$log"

cat <<EOF
DELIVERY for WORK ORDER $orders
Commit: $sha   Directory: $STAGE_DIR
Self-check: $self_check -> $summary
Known gaps: $gaps
EOF
