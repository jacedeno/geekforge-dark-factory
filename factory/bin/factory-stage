#!/usr/bin/env bash
# Planner: declare the current increment. Every seat and guard reads it from run.env.
#
#   factory-stage <increment-dir> --check "<command>"
#   factory-stage --show
#
# <increment-dir> is a top-level directory of the result repository (e.g. the N-th stage). The
# check command may use {repo} (a fresh clone of the commit under test), {dir} (the increment
# directory), {n} (the trailing number of the directory name, if any) and {out} (a new, empty
# output directory). It is what factory-verify and factory-handoff run.
# Records STAGE_BASE = the current HEAD, so scope checks see only this increment's changes.
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

if [[ "${1:-}" == "--show" ]]; then factory_load_run_env; grep -E '^(STAGE_|CHECK_CMD)' "$(factory_state)/run.env" || true; exit 0; fi
dir="${1:-}"; shift || true
check=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) check="$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[[ -n "$dir" && -n "$check" ]] || die "usage: factory-stage <increment-dir> --check \"<command>\""
dir="${dir%/}"
[[ "$dir" =~ ^[A-Za-z0-9._-]+$ ]] || die "the increment directory must be a single top-level name"
[[ "$dir" != "$PLAN_DIR" && "$dir" != "$REVIEW_DIR" && "$dir" != factory && "$dir" != mandates ]] \
  || die "$dir is reserved"
if [[ -n "${FACTORY_ROLE:-}" && "$FACTORY_ROLE" != planner ]]; then die "only the planner sets the increment"; fi

factory_load_run_env
repo="$(factory_repo)"
n="$(grep -oE '[0-9]+$' <<< "$dir" || true)"
factory_set_run_env STAGE_DIR "$dir"
factory_set_run_env STAGE_N "$n"
factory_set_run_env STAGE_BASE "$(git -C "$repo" rev-parse HEAD)"
factory_set_run_env CHECK_CMD "$check"
note "current increment: $dir (base $(git -C "$repo" rev-parse --short HEAD))"
note "builder writes: $dir/   planner writes: $PLAN_DIR/   verifier writes: $REVIEW_DIR/"
