#!/usr/bin/env bash
# Start one seat: Claude Code in that seat's worktree, with its mandate appended to the system
# prompt, the factory guard hooks loaded and permission prompts bypassed (the hooks are the guard).
#
#   factory-seat <planner|builder|verifier> [-- <extra claude args>]
#
# Optional per-seat model in run.env: MODEL_PLANNER, MODEL_BUILDER, MODEL_VERIFIER.
# Once the session is up, join the room with: /jam as <role>
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

role="${1:-}"; shift || true
[[ " ${FACTORY_ROLES[*]} " == *" $role "* ]] || die "usage: factory-seat <${FACTORY_ROLES[*]// /|}>"
[[ "${1:-}" == "--" ]] && shift

seats="$(factory_seats_dir)"
factory_load_run_env
wt="$seats/$role"
[[ -d "$wt" ]] || die "no worktree for $role at $wt; run factory-setup first"

# The mandate and hooks come from the seat's own checkout, so the seat runs exactly the
# factory version its branch carries.
mandate="$wt/mandates/$role.md"
settings="$wt/factory/settings/seat.json"
[[ -f "$mandate" ]] || die "missing mandate $mandate"
[[ -f "$settings" ]] || die "missing settings $settings"

model_var="MODEL_${role^^}"
args=(--dangerously-skip-permissions --settings "$settings"
      --append-system-prompt-file "$mandate" -n "$role")
[[ -n "${!model_var:-}" ]] && args+=(--model "${!model_var}")

export FACTORY_ROLE="$role" FACTORY_SEATS_DIR="$seats" FACTORY_WORKTREE="$wt"
cd "$wt"
exec claude "${args[@]}" "$@"
