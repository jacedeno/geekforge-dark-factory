#!/usr/bin/env bash
# Post a long handoff to the room as numbered parts, each mentioning every recipient.
#
#   factory-post --to <handle>[,<handle>] --title "<title>" <file>
#
# Splits <file> at line boundaries into parts of at most FACTORY_POST_CHARS characters
# (default 3500) and posts each as "@a @b <title> (k/n)" followed by the part, so every part is
# a complete, addressed message and no recipient has to go and read the room. Recipients hold
# off until they have part n/n (their mandates say so).
set -euo pipefail
source "$(dirname "$0")/_lib.sh"

to="" title="" file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to) to="$2"; shift 2 ;;
    --title) title="$2"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) file="$1"; shift ;;
  esac
done
[[ -n "$to" && -n "$title" && -f "$file" ]] || die "usage: factory-post --to <handle>[,<handle>] --title <title> <file>"
factory_load_run_env
[[ -n "${ROOM_ID:-}" ]] || die "no ROOM_ID in run.env"

mentions=""
IFS=',' read -ra handles <<< "$to"
for h in "${handles[@]}"; do h="${h#@}"; h="${h##*/}"; mentions+="@$h "; done

limit="${FACTORY_POST_CHARS:-3500}"
# jam reads --body-file relative to the workspace, so the parts live inside the repository's
# git directory (never tracked).
repo="$(factory_repo)"
work="$(mktemp -d "$repo/.git/factory-post-XXXX")"; trap 'rm -rf "$work"' EXIT
python3 - "$file" "$limit" "$work" <<'PY'
import pathlib, sys
src, limit, out = pathlib.Path(sys.argv[1]), int(sys.argv[2]), pathlib.Path(sys.argv[3])
parts, cur = [], ""
for line in src.read_text().splitlines(keepends=True):
    while len(line) > limit:                      # a single over-long line is cut hard
        if cur: parts.append(cur); cur = ""
        parts.append(line[:limit]); line = line[limit:]
    if len(cur) + len(line) > limit:
        parts.append(cur); cur = ""
    cur += line
if cur.strip(): parts.append(cur)
for i, p in enumerate(parts, 1):
    (out / f"{i:03d}").write_text(p)
PY
total="$(ls "$work" | wc -l)"
k=0
for part in "$work"/*; do
  k=$((k + 1))
  msg="$work/msg"
  { printf '%s%s (%d/%d)\n\n' "$mentions" "$title" "$k" "$total"; cat "$part"; } > "$msg"
  (cd "$repo" && jam send "$ROOM_ID" --body-file "${msg#"$repo"/}" >/dev/null)
done
note "posted $total part(s) of $file to $mentions"
