#!/usr/bin/env python3
"""Refuse commit messages that carry tool or AI attribution. Applies to every commit."""
import re
import sys

ATTRIBUTION = re.compile(
    r"(co-authored-by:.*(claude|anthropic|copilot|openai|gpt|gemini|cursor|codex|bot\b)"
    r"|generated (with|by) .*(claude|ai\b|copilot|gpt|codex)"
    r"|\U0001F916)",
    re.IGNORECASE,
)

with open(sys.argv[1], encoding="utf-8") as fh:
    for line in fh:
        if line.startswith("#"):
            continue
        if ATTRIBUTION.search(line):
            sys.stderr.write(f"commit-msg: attribution is not allowed in commit messages: {line.strip()}\n")
            sys.exit(1)
